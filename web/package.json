{
  "name": "gecko-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "PATH=$HOME/.cargo/bin:$PATH wasm-pack build ../crates/gecko-wasm --release --target web --out-dir ../../web/src/wasm/pkg",
    "wasm:dev": "PATH=$HOME/.cargo/bin:$PATH wasm-pack build ../crates/gecko-wasm --release --no-opt --target web --out-dir ../../web/src/wasm/pkg",
    "build:dev": "vite build",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:parity": "npm run wasm && node --test scripts/wasm-parity.mjs",
    "test:contract": "GECKO_API_SAMPLES=$PWD/contract/api-samples.generated.ts cargo test --release -p gecko-cli api_samples && tsc -p tsconfig.contract.json --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
